# The agent relay — proposal intake for box-proposed profile changes.
#
# POSTURE NOTE (SECURITY.md "What's actually in place"): this is the first
# custom daemon resident on the control plane. Before it, the plane ran
# headscale + sshd + a reaper *timer* — nothing we wrote stayed running.
# The relay listens ONLY on the private net (a tsnet node, no public
# listener), authenticates callers by net identity (WhoIs), and can do one
# thing: stage an inert proposal file for the laptop to review. It never
# applies anything. Enabling it is a deliberate step, not part of setup:
#   systemctl --user enable --now daybox-relay
# First start self-enrolls on the net (it runs next to headscale).
[Unit]
Description=daybox agent relay (net-side proposal intake; the laptop approves)
After=network-online.target

[Service]
ExecStart=%h/.config/daybox/agent/daybox-agent relay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
