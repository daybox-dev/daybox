#!/bin/bash
# daybox — summon / inspect / reap an ephemeral beefy box from the always-on
# control-plane box. All cloud-API knowledge lives behind the provider
# contract (five primitives: summon / reap / probe / attach-volume /
# user_data — providers/hetzner.sh documents it); no third-party binaries.
#
# A profile is a whole daybox (own server + volume + state); -p <name> selects
# one on any verb, else the 'profile use' default, else 'default'. See
# README: Profiles.
#
# Usage:
#   daybox [-p PROFILE] ...  select a profile for any verb below (default: default)
#   daybox setup            one-time bootstrap of the current profile's volume
#   daybox up [type]        create the big box (default type from config), print
#                           "IP <ip>" and "HOSTKEY <known_hosts line>" on stdout
#   daybox status           the whole deployment: every profile's box (uptime,
#                           price, counters) + the net table (-p: one profile)
#   daybox ssh [cmd]        fresh shell on the big box (or run cmd) — tmux is
#                           a user choice, not imposed (see: attach)
#   daybox attach           attach the persistent tmux session (the only verb
#                           that starts tmux) — handy from Termius
#   daybox down             detach volume + DELETE the server (stops billing)
#   daybox reap             called by systemd timer: down after sustained idle
#   daybox profile ...      add|ls|use|rename|rm|seed profiles (README: Profiles)
#   daybox profile seed     show|init|path the profile.toml that declares
#                           what this profile's boxes CARRY (README: Profile seeds)
#   daybox render           debug: print the cloud-init user-data exactly as it
#                           would be sent (all placeholders expanded)
#
# This script lives in the daybox git repo and is symlinked into ~/.local/bin
# by install.sh. The cloud-init template and docs resolve RELATIVE TO THE
# REPO, so a `git pull` updates behavior on every machine at once. The
# DEPLOYMENT (who/where you are) is machine-local and never committed.
#
# Machine-local files in ~/.config/daybox/:
#   config.local  REQUIRED — 'daybox init' writes it (see README: Configuration)
#   token         provider API token (chmod 600) — for hetzner: Console >
#                 project > Security > API tokens > read/write
#   keys/         authorized ssh pubkeys injected into summoned boxes
#                 (falls back to the repo keys/ dir if empty)
#   agent/        daybox-agent linux binary (built from agent/, pushed to
#                 each summoned box; its presence + headscale = net join)
#   state/        volume id, resolved key names, idle counters
#   known_hosts   host key of the current big box

set -euo pipefail

SELF=$(readlink -f "$0")                       # resolve through the symlink
REPO_DIR=$(cd "$(dirname "$SELF")/.." && pwd)  # …to the repo checkout

CONF_DIR="$HOME/.config/daybox"
STATE_DIR="$CONF_DIR/state"
TEMPLATE="$REPO_DIR/cloud-init/cloud-init.yaml.template"

log() { printf '[daybox] %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

mkdir -p "$STATE_DIR"
if [ -f "$CONF_DIR/config.local" ]; then
    # shellcheck source=/dev/null
    . "$CONF_DIR/config.local"
fi

# --- profile selection (README: Profiles) ------------------------------------
# A profile is a whole daybox: its own server, volume and state, so two
# profiles summon and reap as independent boxes. `-p <name>` (anywhere on the
# line) selects one; else the 'profile use' selection; else 'default'. Strip
# the flag out of the positional args before the verb dispatch sees them.
PROFILE=""
_ARGV=()
while [ $# -gt 0 ]; do
    case "$1" in
        -p|--profile)     PROFILE="${2:-}"; shift 2 || die "-p needs a profile name" ;;
        -p=*|--profile=*) PROFILE="${1#*=}"; shift ;;
        *)                _ARGV+=("$1"); shift ;;
    esac
done
set -- ${_ARGV[@]+"${_ARGV[@]}"}
# status distinguishes "scoped to one profile" (-p given) from the bare verb
# (shows every profile) — the default-profile fallback below erases that.
PROFILE_EXPLICIT=${PROFILE:+1}
[ -n "$PROFILE" ] || PROFILE=$(cat "$STATE_DIR/current_profile" 2>/dev/null || echo default)

# tool defaults — deployment-wide; a profile's config can override per box
: "${PROVIDER:=hetzner}"
: "${SERVER_TYPE:=ccx33}"
: "${IMAGE:=ubuntu-24.04}"
: "${LOCATION:=hil}"
: "${VOLUME_SIZE_GB:=50}"
: "${REMOTE_USER:=dev}"
: "${REAP_AFTER_IDLE_MIN:=30}"
: "${LOAD_BUSY:=0.40}"
# Hard lifetime cap — the runaway backstop. The idle reaper handles the normal
# case; this bounds the pathological one, where a box looks busy forever
# (runaway process, forgotten session) and bills until someone notices. Hours;
# 0 disables it, which means nothing but the idle reaper stops the meter.
: "${MAX_LIFETIME_HOURS:=12}"
: "${NET_USER:=dev}"
: "${NET_PORT:=8080}"
: "${NET_CONTROL_URL:=http://${LITTLEBOX_IP:-}:$NET_PORT}"
NET_AGENT_BIN="$CONF_DIR/agent/daybox-agent"

valid_profile_name() { case "$1" in ''|*[!a-z0-9-]*) return 1 ;; *) return 0 ;; esac; }

# Charset-validate the two values that reach a root shell, a remote ssh
# command line, and the bootcmd firewall YAML. This is not only injection
# hygiene: a malformed LITTLEBOX_IP breaks the bootcmd YAML, cloud-init drops
# that stage, and the box boots with public :22 OPEN — the value that exists
# to close the firewall must never be able to fail it open. Checked at load
# AND after every profile layer (profiles can override REMOTE_USER).
validate_identity_values() {
    [ -z "${LITTLEBOX_IP:-}" ] || [[ "$LITTLEBOX_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] \
        || die "LITTLEBOX_IP must be a plain IPv4 address (got '$LITTLEBOX_IP')"
    [[ "$REMOTE_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] \
        || die "REMOTE_USER must be a plain unix username (got '$REMOTE_USER')"
}
validate_identity_values

# derive_profile <name>: point every per-box name + path at <name>, then layer
# that profile's own config (server type, location, git identity, …) on top.
# SERVER_NAME/VOLUME_NAME are DERIVED, never configured — the clean cut that
# lets many profiles coexist without a per-name special case (README: Profiles).
derive_profile() {
    valid_profile_name "$1" || die "invalid profile '$1' (lowercase letters, digits, dashes)"
    PROFILE="$1"
    PROFILE_CONF="$CONF_DIR/profiles/$PROFILE"
    PROFILE_STATE="$STATE_DIR/profiles/$PROFILE"
    SERVER_NAME="daybox-$PROFILE"
    VOLUME_NAME="daybox-$PROFILE-vol"
    KNOWN_HOSTS="$PROFILE_STATE/known_hosts"
    mkdir -p "$PROFILE_STATE"
    # Reset every knob to its deployment-wide baseline before layering this
    # profile's config, so nothing leaks between profiles in a loop
    # (see _PROFILE_KNOBS above).
    local _k _d
    for _k in "${_PROFILE_KNOBS[@]}"; do _d="DEPLOY_$_k"; printf -v "$_k" '%s' "${!_d:-}"; done
    if [ -f "$PROFILE_CONF/config" ]; then
        # shellcheck source=/dev/null
        . "$PROFILE_CONF/config"
    fi
    validate_identity_values
    load_provider
}

# The provider: one file in providers/ implementing the five-primitive
# contract (documented at the top of providers/hetzner.sh). Core code below
# never talks to a cloud API directly and parses only the contract's
# normalized server JSON — a new cloud is a new providers/<name>.sh, nothing
# else. Loaded by derive_profile — NOT once at startup — so config.local and
# each profile's config can set PROVIDER, and the multi-profile loops (reap,
# profile ls) re-select it per profile. That placement is load-bearing:
# probing a box through the wrong provider reads as `null`, and the reaper
# would reset its counters and never stop the billing.
#
# Deployment-wide baselines, snapshotted once. Profile configs LAYER onto
# the environment, so in any loop over profiles one profile's values would
# leak into the next — derive_profile resets EVERY knob to these before
# layering. PROVIDER got this treatment first (the probe-through-the-wrong-
# provider bug above); the same leak applied to all the rest: one profile's
# MAX_LIFETIME_HOURS=0 silently removed the next one's runaway cap, and a
# leaked REMOTE_USER made the next profile's probe fail as the wrong user
# until the 1h unreachable rule force-reaped a healthy box.
_PROFILE_KNOBS=(PROVIDER SERVER_TYPE IMAGE LOCATION VOLUME_SIZE_GB REMOTE_USER
                REAP_AFTER_IDLE_MIN LOAD_BUSY MAX_LIFETIME_HOURS NET_USER
                GIT_NAME GIT_EMAIL)
for _k in "${_PROFILE_KNOBS[@]}"; do printf -v "DEPLOY_$_k" '%s' "${!_k:-}"; done
unset _k
load_provider() {
    valid_profile_name "$PROVIDER" || die "invalid provider name '$PROVIDER'"
    [ "$PROVIDER" != "${_PROVIDER_LOADED:-}" ] || return 0
    [ -f "$REPO_DIR/providers/$PROVIDER.sh" ] || die "unknown provider '$PROVIDER' — expected $REPO_DIR/providers/$PROVIDER.sh"
    # shellcheck source=providers/hetzner.sh
    . "$REPO_DIR/providers/$PROVIDER.sh"
    _PROVIDER_LOADED=$PROVIDER
}
derive_profile "$PROFILE"

# authorized pubkeys: machine-local dir wins; repo dir is the fallback
KEYS_DIR="$REPO_DIR/keys"
if compgen -G "$CONF_DIR/keys/*.pub" >/dev/null; then
    KEYS_DIR="$CONF_DIR/keys"
fi

# The seed is required. Inventing a default at summon time would mean a box
# silently carrying something its profile never declared — exactly the drift
# this design removes.
SEED_FILE_FOR() { echo "$CONF_DIR/profiles/$1/profile.toml"; }
need_seed() {
    local f; f=$(SEED_FILE_FOR "$PROFILE")
    [ -f "$f" ] || die "profile '$PROFILE' has no seed at $f
  A box carries what its profile declares; there is no default at summon time.
  create one with:  daybox profile seed init $PROFILE"
}

missing_config() { [ -z "${LITTLEBOX_IP:-}" ] || [ -z "${GIT_NAME:-}" ] || [ -z "${GIT_EMAIL:-}" ]; }
need_config() {
    if missing_config; then
        die "deployment config missing/incomplete — run 'daybox init', or set the
  REQUIRED values in ~/.config/daybox/config.local (see README: Configuration)"
    fi
}

volume_id() { cat "$PROFILE_STATE/volume_id" 2>/dev/null || die "profile '$PROFILE' has no volume yet — run: daybox -p $PROFILE profile add $PROFILE (or: daybox setup)"; }

# ------------------------------------------------------------ rendering ----
build_authkeys_snippet() { # every repo pubkey as YAML list items
    local f
    for f in "$KEYS_DIR"/*.pub; do
        [ -e "$f" ] || die "no authorized pubkeys in $KEYS_DIR"
        printf -- '- %s\n' "$(tr -d '\n' < "$f")"
    done
}

render_user_data() { # $1 = volume id — expand includes + placeholders
    local vid=$1
    # These values land inside a shell script (firstboot) and a heredoc; a
    # newline is the one character no quoting below can contain. Everything
    # else is made safe by LITERAL substitution (bash ${var//…}, not sed —
    # sed replacement text reinterprets &, \\ and the delimiter).
    case "$GIT_NAME$GIT_EMAIL$REMOTE_USER" in
        *$'\n'*|*$'\r'*) die "GIT_NAME/GIT_EMAIL/REMOTE_USER must be single-line values" ;;
    esac
    build_authkeys_snippet > "$PROFILE_STATE/authkeys.snippet"
    local rendered
    rendered=$(awk -v repo="$REPO_DIR" \
        -v sshkeys="$PROFILE_STATE/authkeys.snippet" \
        -v seed="$(SEED_FILE_FOR "$PROFILE")" -v sq="'\''" '
        # include a file, indent kept. Full-line comments are dropped (the
        # authored copies keep them; the box does not need them) because
        # user_data has a hard 32KB API cap and comments were >⅓ of it.
        # First-line #! survives. Lines inside string literals are safe for
        # REPO-AUTHORED files only — none of ours put a #-leading line in a
        # string (checked at authoring time; the render size guard catches
        # drift). The USER-authored seed gets toml=1: comments are stripped
        # there too (a template-copied profile carries ~3KB of them), but
        # NEVER inside a TOML multiline string — a #-line inside a [setup]
        # command is content, and stripping it would make the box run a
        # different command than the profile declares, the exact silent
        # drift the seed contract forbids. String state is tracked by
        # toggling on each """ / three-apostrophe delimiter; a comment line
        # outside a string never toggles (prose may quote delimiters).
        function toggles(line, instr,   t, n) {
            t = line
            n = gsub(/"""/, "", t) + gsub(sq sq sq, "", t)
            return (instr + n) % 2
        }
        function emit(path, toml,   indent, line, first, instr) {
            match($0, /^ */); indent = substr($0, 1, RLENGTH)
            first = 1; instr = 0
            while ((getline line < path) > 0) {
                if ((toml && instr) || !(line ~ /^[[:space:]]*#/) \
                    || (!toml && first && line ~ /^#!/))
                    print indent line
                if (toml && !(instr == 0 && line ~ /^[[:space:]]*#/))
                    instr = toggles(line, instr)
                first = 0
            }
            close(path)
        }
        /@REPO:/ {
            path = $0; sub(/^ *@REPO:/, "", path); sub(/@[[:space:]]*$/, "", path)
            emit(repo "/" path); next
        }
        /@FILE:/ {
            path = $0; sub(/^ *@FILE:/, "", path); sub(/@[[:space:]]*$/, "", path)
            emit(path); next
        }
        /@SSH_KEYS@/ { emit(sshkeys); next }
        /@PROFILE_SEED@/ { emit(seed, 1); next }
        { print }
    ' "$TEMPLATE")
    # replacements are QUOTED: under bash 5.2's patsub_replacement an
    # unquoted & in the replacement re-inserts the matched pattern
    rendered=${rendered//@VOLUME_ID@/"$vid"}
    rendered=${rendered//@REMOTE_USER@/"$REMOTE_USER"}
    rendered=${rendered//@GIT_NAME@/"$GIT_NAME"}
    rendered=${rendered//@GIT_EMAIL@/"$GIT_EMAIL"}
    rendered=${rendered//@LITTLEBOX_IP@/"$LITTLEBOX_IP"}
    printf '%s\n' "$rendered"
}

reset_idle() { echo 0 > "$PROFILE_STATE/idle_ticks"; echo 0 > "$PROFILE_STATE/unreachable_ticks"; }

# box_age_min ISO8601 -> whole minutes since the box was created.
# Hetzner emits e.g. 2026-07-21T15:32:14+00:00. Fails (non-zero) rather than
# guessing if the timestamp is unparseable, so callers can skip the cap
# instead of reaping a box on a bad clock or a changed API format.
box_age_min() {
    local created=$1 epoch now
    # Reject empty/null BEFORE date sees them. `date -d ""` does not fail — it
    # returns midnight today, which reads as a many-hour-old box and would
    # force-reap a perfectly healthy one. Same for jq's "null" on a missing
    # field. A timestamp we cannot trust must DISABLE the cap, never fire it.
    case "$(printf '%s' "$created" | tr -d '[:space:]')" in
        ""|null|NULL) return 1 ;;
    esac
    epoch=$(date -d "$created" +%s 2>/dev/null) || return 1
    now=$(date +%s)
    [ "$epoch" -gt 0 ] 2>/dev/null || return 1
    echo $(( (now - epoch) / 60 ))
}

pin_hostkey() { # $1 = ip — rescan every time: Hetzner reuses IPs, and a stale
    # key from a previous box on this address would break every ssh path
    ssh-keyscan -T 5 "$1" 2>/dev/null > "$KNOWN_HOSTS"
    [ -s "$KNOWN_HOSTS" ] || die "ssh-keyscan of $1 failed"
}

# ---------------------------------------------------------------- setup ----
ensure_volume() { # create/adopt the CURRENT profile's volume, cache its id, echo it
    local vid
    vid=$(provider_volume_ensure "$VOLUME_NAME" "$VOLUME_SIZE_GB" "$LOCATION")
    echo "$vid" > "$PROFILE_STATE/volume_id"
    reset_idle
    echo "$vid"
}

cmd_setup() { # one-time bootstrap of the CURRENT profile (default unless -p)
    need_config
    provider_check_credentials
    provider_prepare_ssh_keys "$KEYS_DIR"
    local vid; vid=$(ensure_volume)
    log "setup complete for profile '$PROFILE'. volume id: $vid"
}

# ------------------------------------------------------------- profiles ----
# A profile is a whole daybox (README: Profiles): `profile add` creates its
# volume; `up -p <name>` summons it; they coexist and reap independently.
list_profiles() { # every profile that has been set up (has a state dir)
    local d
    for d in "$STATE_DIR"/profiles/*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done
}

profile_add() {
    need_config
    provider_check_credentials
    local name=${1:-} type=${2:-}
    [ -n "$name" ] || die "usage: daybox profile add <name> [server-type]"
    valid_profile_name "$name" || die "invalid profile '$name' (lowercase letters, digits, dashes)"
    [ -e "$CONF_DIR/profiles/$name/config" ] && die "profile '$name' already exists (edit $CONF_DIR/profiles/$name/config)"
    derive_profile "$name"
    mkdir -p "$PROFILE_CONF"
    # seed a profile config the user can edit: box shape + this profile's
    # default git identity (falls back to the deployment-wide one from
    # config.local when left blank). SERVER_NAME/VOLUME_NAME are NOT knobs —
    # they derive from the profile name (README: Profiles).
    cat > "$PROFILE_CONF/config" <<EOF
# daybox profile '$name' — overrides config.local for this box only.
# Server + volume names are derived (daybox-$name / daybox-$name-vol), not set.
#SERVER_TYPE=${type:-$SERVER_TYPE}
#LOCATION=$LOCATION
#VOLUME_SIZE_GB=$VOLUME_SIZE_GB
# This profile's git identity (its box's gh/git/ssh live on its own volume):
#GIT_NAME="$GIT_NAME"
#GIT_EMAIL=$GIT_EMAIL
EOF
    [ -n "$type" ] && sed -i "s|^#SERVER_TYPE=.*|SERVER_TYPE=$type|" "$PROFILE_CONF/config"
    # the seed: what this profile's boxes CARRY (README: Profile seeds)
    cp "$REPO_DIR/profile.default.toml" "$PROFILE_CONF/profile.toml"
    provider_prepare_ssh_keys "$KEYS_DIR"
    local vid; vid=$(ensure_volume)
    log "profile '$name' ready (volume $vid). summon it with: daybox up -p $name"
}

profile_ls() {
    provider_check_credentials
    local cur p srv vid vsize state
    cur=$(cat "$STATE_DIR/current_profile" 2>/dev/null || echo default)
    printf '%-16s %-8s %-10s %s\n' PROFILE DEFAULT BOX VOLUME
    for p in $(list_profiles); do
        # subshell: contain a die and any config leakage per profile,
        # same as the reap loop
        (
            derive_profile "$p"
            srv=$(provider_probe "$SERVER_NAME" | jq -r '.status // "-"')
            vid=$(cat "$PROFILE_STATE/volume_id" 2>/dev/null || echo "")
            if [ -n "$vid" ]; then
                vsize=$(provider_volume_size "$vid")
                state="${vsize}GB"
            else
                state="(no volume)"
            fi
            printf '%-16s %-8s %-10s %s\n' "$p" \
                "$([ "$p" = "$cur" ] && echo '*' || echo '-')" "$srv" "$state"
        ) || log "[$p] listing failed — skipping"
    done
}

profile_use() {
    local name=${1:-}
    [ -n "$name" ] || die "usage: daybox profile use <name>"
    valid_profile_name "$name" || die "invalid profile '$name'"
    [ -d "$STATE_DIR/profiles/$name" ] || die "no such profile '$name' — create it: daybox profile add $name"
    echo "$name" > "$STATE_DIR/current_profile"
    log "default profile is now '$name' (bare 'daybox up' targets it)"
}

profile_rename() {
    provider_check_credentials
    local old=${1:-} new=${2:-}
    [ -n "$old" ] && [ -n "$new" ] || die "usage: daybox profile rename <old> <new>"
    valid_profile_name "$new" || die "invalid profile '$new'"
    [ -d "$STATE_DIR/profiles/$old" ] || die "no such profile '$old'"
    [ -e "$STATE_DIR/profiles/$new" ] && die "profile '$new' already exists"
    # the server + net node derive their names from the profile; renaming a
    # live box would orphan the reaper counters and leave a net ghost. Require
    # it down first (README: Profiles).
    derive_profile "$old"
    [ "$(provider_probe "$SERVER_NAME")" = "null" ] \
        || die "profile '$old' has a live box — 'daybox down -p $old' before renaming"
    local vid
    vid=$(cat "$PROFILE_STATE/volume_id" 2>/dev/null || echo "")
    if [ -n "$vid" ]; then
        log "renaming volume daybox-$old-vol → daybox-$new-vol"
        provider_volume_rename "$vid" "daybox-$new-vol"
    fi
    mv "$STATE_DIR/profiles/$old" "$STATE_DIR/profiles/$new"
    [ -d "$CONF_DIR/profiles/$old" ] && mv "$CONF_DIR/profiles/$old" "$CONF_DIR/profiles/$new"
    [ "$(cat "$STATE_DIR/current_profile" 2>/dev/null)" = "$old" ] && echo "$new" > "$STATE_DIR/current_profile"
    log "renamed profile '$old' → '$new'"
}

profile_rm() {
    provider_check_credentials
    local name=${1:-} purge=${2:-}
    [ -n "$name" ] || die "usage: daybox profile rm <name> [--purge]"
    [ "$name" = default ] && die "refusing to remove the 'default' profile"
    [ -d "$STATE_DIR/profiles/$name" ] || die "no such profile '$name'"
    derive_profile "$name"
    # reap the box if it is up (frees the volume for deletion, stops billing)
    [ "$(provider_probe "$SERVER_NAME")" != "null" ] && cmd_down
    local vid
    vid=$(cat "$PROFILE_STATE/volume_id" 2>/dev/null || echo "")
    if [ "$purge" = "--purge" ] && [ -n "$vid" ]; then
        log "deleting volume daybox-$name-vol (id $vid) — workspace state is gone for good"
        provider_volume_delete "$vid"
    elif [ -n "$vid" ]; then
        log "profile config/state removed; volume daybox-$name-vol (id $vid) KEPT."
        log "  delete it yourself when sure:  daybox profile rm $name --purge"
    fi
    rm -rf "$STATE_DIR/profiles/$name" "$CONF_DIR/profiles/$name"
    [ "$(cat "$STATE_DIR/current_profile" 2>/dev/null)" = "$name" ] && rm -f "$STATE_DIR/current_profile"
    log "removed profile '$name'"
}

# profile_seed — show or create the seed that says what a box carries.
profile_seed() {
    local sub=${1:-show} name=${2:-$PROFILE}
    valid_profile_name "$name" || die "invalid profile '$name'"
    local f="$CONF_DIR/profiles/$name/profile.toml"
    case "$sub" in
        show)
            [ -f "$f" ] || die "profile '$name' has no seed at $f
  create one with: daybox profile seed init $name"
            echo "# $f"; cat "$f" ;;
        init)
            [ -e "$f" ] && die "'$name' already has a seed at $f (edit it directly)"
            mkdir -p "$(dirname "$f")"
            cp "$REPO_DIR/profile.default.toml" "$f"
            log "wrote $f — edit it, then: daybox up -p $name" ;;
        path) echo "$f" ;;
        *)    die "usage: daybox profile seed [show|init|path] [<name>]" ;;
    esac
}

cmd_profile() {
    local sub=${1:-ls}; shift || true
    case "$sub" in
        add)          profile_add "$@" ;;
        ls|list)      profile_ls ;;
        use)          profile_use "$@" ;;
        rename|mv)    profile_rename "$@" ;;
        rm|remove)    profile_rm "$@" ;;
        seed)         profile_seed "$@" ;;
        *)            die "unknown: profile $sub  (add|ls|use|rename|rm|seed)" ;;
    esac
}

# ------------------------------------------------------------------- up ----
emit_conn() { # stdout contract consumed by the laptop CLI: IP + HOSTKEY lines
    local ip=$1
    echo "IP $ip"
    # host keys were scanned via the public address; rewrite the host field so
    # each line matches whatever address the client was just told to use
    sed -e "s/^[^ ]*/$ip/" -e 's/^/HOSTKEY /' "$KNOWN_HOSTS"
}

# ------------------------------------------------------------------ net ----
# The daybox net (the README): self-hosted headscale on this control plane
# plus userspace tsnet agents — no TUN, no vendor apps. Enabled when headscale
# is installed here and the agent binary has been dropped at $NET_AGENT_BIN.
net_enabled() { command -v headscale >/dev/null 2>&1 && [ -x "$NET_AGENT_BIN" ]; }
need_net() { # a daybox exists ONLY on the net — refuse to summon without it
    net_enabled || die "the daybox net is not set up on this control plane:
  needs headscale running and the agent binary at $NET_AGENT_BIN.
  A daybox is only ever reachable over the net — set it up first (the README)."
}

net_user_id() {
    headscale users list -o json 2>/dev/null \
      | jq -r --arg u "$NET_USER" '(. // [])[] | select(.name==$u) | .id' | head -1
}

net_nodes_json() { headscale nodes list -o json 2>/dev/null | jq '. // []'; }

net_join_box() { # $1 = public ip — push agent + single-use ephemeral key.
    # A daybox exists ONLY on the net, so every step here is fatal: on any
    # failure this returns non-zero and cmd_up tears the box down. No silent,
    # degraded, off-net box is ever left running.
    local ip=$1 uid key nid
    uid=$(net_user_id)
    [ -n "$uid" ] || { log "net: no headscale user '$NET_USER'"; return 1; }
    # a summon means no node legitimately holds this box's name — purge any
    # stale one first. A leftover claims the name, headscale gives the new
    # node a deduped given_name (daybox-<profile>-1), and every exact-name
    # check below goes blind (seen 2026-07-22: summon aborted, wrong node
    # removed on the way down).
    for nid in $(net_nodes_json | jq -r --arg h "$SERVER_NAME" \
            '.[] | select(.name==$h or .given_name==$h) | .id'); do
        if headscale nodes delete -i "$nid" --force >/dev/null 2>&1; then
            log "net: purged stale node '$SERVER_NAME' (id $nid)"
        else
            log "net: WARNING: stale node id $nid would not delete — the box may join under a deduped name"
        fi
    done
    key=$(headscale preauthkeys create --user "$uid" --ephemeral --expiration 15m 2>/dev/null | tail -1)
    [ -n "$key" ] || { log "net: could not mint pre-auth key"; return 1; }
    log "net: enrolling box on the daybox net"
    local sshopts=(-o UserKnownHostsFile="$KNOWN_HOSTS" -o BatchMode=yes -o ConnectTimeout=10)
    if ! scp -q "${sshopts[@]}" "$NET_AGENT_BIN" "$REPO_DIR/remote/daybox-agent.service" \
             "$REMOTE_USER@$ip:/tmp/"; then
        log "net: could not copy agent to box"; return 1
    fi
    # the key travels via stdin (never argv/ps); single-use + 15min expiry anyway
    if ! printf '%s\n' "$key" | ssh "${sshopts[@]}" "$REMOTE_USER@$ip" "
        set -e
        sudo install -m 755 /tmp/daybox-agent /usr/local/bin/daybox-agent
        sudo install -d -m 700 /var/lib/daybox-agent
        sudo install -m 600 /dev/stdin /var/lib/daybox-agent/authkey
        printf 'DAYBOX_CONTROL=%s\n' '$NET_CONTROL_URL' | sudo tee /etc/default/daybox-agent >/dev/null
        sudo cp /tmp/daybox-agent.service /etc/systemd/system/daybox-agent.service
        sudo systemctl daemon-reload
        sudo systemctl enable --now daybox-agent
        rm -f /tmp/daybox-agent /tmp/daybox-agent.service"; then
        log "net: agent install failed on box"; return 1
    fi
    local i addr
    for i in $(seq 1 30); do
        # match the hostname (.name), not given_name: headscale dedupes the
        # latter on collision, and this poll must find the box regardless
        addr=$(net_nodes_json | jq -r --arg h "$SERVER_NAME" \
            '[.[] | select(.name==$h and ((.online // .connected // false)==true))][0].ip_addresses[0] // empty')
        if [ -n "$addr" ]; then
            log "net: box online at $addr (from an enrolled device: ssh over 'daybox-agent dial')"
            return 0
        fi
        sleep 2
    done
    log "net: box never came online — check on box: systemctl status daybox-agent"
    return 1
}

# net_node_online: is this profile's box registered AND online on the net?
net_node_online() {
    [ -n "$(net_nodes_json | jq -r --arg h "$SERVER_NAME" \
        '[.[] | select(.name==$h and ((.online // .connected // false)==true))][0].id // empty')" ]
}

# seed_verdict <ip>: firstboot's verdict on an existing box ("ok", "FAILED…",
# or empty when unreadable). Bounded: a wedged sshd must not hang the caller.
seed_verdict() {
    timeout 20 ssh -o UserKnownHostsFile="$KNOWN_HOSTS" -o BatchMode=yes -o ConnectTimeout=5 \
        "$REMOTE_USER@$1" 'cat /var/lib/daybox/seed.status 2>/dev/null' 2>/dev/null || true
}

wait_ready() { # $1 = ip : wait for sshd, then for firstboot's verdict
    local ip=$1 i st
    for i in $(seq 1 60); do nc -z -w 2 "$ip" 22 2>/dev/null && break; sleep 2; done
    nc -z -w 2 "$ip" 22 2>/dev/null || die "ssh port never opened on $ip"
    pin_hostkey "$ip"
    # Provisioning is finished when firstboot writes its verdict. There is
    # deliberately no "connect anyway" fallback: handing back a box that is
    # missing what its profile declared, while reporting success, is the exact
    # failure this design exists to prevent.
    for i in $(seq 1 300); do
        st=$(ssh -o UserKnownHostsFile="$KNOWN_HOSTS" -o BatchMode=yes -o ConnectTimeout=5 \
             "$REMOTE_USER@$ip" 'cat /var/lib/daybox/seed.status 2>/dev/null' 2>/dev/null || true)
        case "$st" in
            ok) return 0 ;;
            FAILED*)
                log "provisioning FAILED on $ip:"
                printf '%s\n' "$st" >&2
                die "the box is left RUNNING so you can inspect it:
    daybox -p $PROFILE ssh    then: sudo cat /var/log/cloud-init-output.log
  fix $(SEED_FILE_FOR "$PROFILE") and re-summon, or: daybox -p $PROFILE down" ;;
        esac
        sleep 2
    done
    die "provisioning never finished on $ip (no verdict in /var/lib/daybox/seed.status after 10min)"
}

cmd_up() {
    need_config
    provider_check_credentials
    need_seed
    need_net
    local type="${1:-$SERVER_TYPE}" existing ip vid price
    existing=$(provider_probe "$SERVER_NAME")
    if [ "$existing" != "null" ]; then
        ip=$(printf '%s' "$existing" | jq -r '.ip')
        log "big box already up at $ip ($(printf '%s' "$existing" | jq -r '.type'))"
        pin_hostkey "$ip"
        # An existing box is handed back ONLY if it is a real daybox: seed ok
        # and on the net. Anything else — an interrupted summon, a failed
        # firstboot — must not be re-blessed here: emitting it would revive
        # exactly the off-net-but-reachable state the net invariant forbids,
        # and reset_idle would keep it alive on top.
        local verdict
        verdict=$(seed_verdict "$ip")
        if [ "$verdict" != ok ]; then
            log "existing box has no clean provisioning verdict (${verdict:-unreadable}) — tearing it down (fail closed)"
            cmd_down || true
            die "stale half-provisioned box removed; re-run: daybox up"
        fi
        if ! net_node_online; then
            log "existing box is not on the net — re-enrolling it"
            if ! net_join_box "$ip"; then
                log "net join failed — tearing the box down (a daybox must be on the net)"
                cmd_down || true
                die "summon aborted: box could not join the daybox net"
            fi
        fi
        reset_idle
        emit_conn "$ip"
        return 0
    fi

    vid=$(volume_id)
    # a volume can only attach to one server; make sure it is free
    local attached
    attached=$(provider_volume_attached_to "$vid")
    if [ -n "$attached" ]; then
        log "volume still attached to server $attached — detaching"
        provider_volume_detach "$vid"
        sleep 3
    fi

    # The provider caps user_data size (Hetzner: 32768 bytes); catch it here
    # so the error names the real problem (an oversized render — usually a
    # grown profile seed) instead of an opaque API validation error.
    local ud ud_bytes ud_cap
    ud=$(render_user_data "$vid")
    ud_bytes=$(printf '%s' "$ud" | wc -c | tr -d ' ')
    ud_cap=$(provider_user_data_max_bytes)
    [ "$ud_bytes" -le "$ud_cap" ] || die "rendered cloud-init is $ud_bytes bytes — over the ${ud_cap}-byte user_data cap.
  The usual cause is a large profile seed: daybox profile seed path $PROFILE"

    price=$(provider_price_hourly "$type" "$LOCATION" || true)
    log "creating $type in $LOCATION (~€${price:-?}/h gross) ..."
    local box id
    box=$(printf '%s' "$ud" | provider_summon "$SERVER_NAME" "$type" "$IMAGE" "$LOCATION" "$vid") \
        || die "summon failed — no box was created (provider error above)"
    id=$(printf '%s' "$box" | jq -r '.id // empty')
    ip=$(printf '%s' "$box" | jq -r '.ip // empty')
    [ -n "$id" ] && [ -n "$ip" ] || die "provider returned no usable box: ${box:-<empty>}"
    log "server $id running at $ip — waiting for provisioning"

    wait_ready "$ip"
    if ! net_join_box "$ip"; then
        log "net join failed — tearing the box down (a daybox must be on the net)"
        cmd_down || true
        die "summon aborted: box could not join the daybox net"
    fi
    reset_idle
    if [ "${MAX_LIFETIME_HOURS:-0}" -gt 0 ] 2>/dev/null; then
        log "ready. ~€${price:-?}/h until 'daybox down' (idle reaper: ${REAP_AFTER_IDLE_MIN}min; hard cap: ${MAX_LIFETIME_HOURS}h)"
    else
        log "ready. ~€${price:-?}/h until 'daybox down' (idle reaper: ${REAP_AFTER_IDLE_MIN}min; NO lifetime cap)"
    fi
    emit_conn "$ip"
}

# --------------------------------------------------------------- status ----
# status_one: one profile's block of the consolidated status — box, price and
# counters for the CURRENT profile (derive_profile + creds are the caller's job)
status_one() {
    local s
    s=$(provider_probe "$SERVER_NAME")
    echo "profile '$PROFILE':"
    if [ "$s" = "null" ]; then
        echo "  no box running (volume + snapshot state persist; billing: volume only)"
        return 0
    fi
    local type price
    type=$(printf '%s' "$s" | jq -r '.type')
    price=$(provider_price_hourly "$type" "$LOCATION" || true)
    printf '%s' "$s" | jq -r --arg p "${price:-?}" \
        '"  big box: \(.name)  id=\(.id)  \(.type)  \(.status)
  ip: \(.ip)
  created: \(.created)   (~€" + $p + "/h gross)"'
    echo "  ingress: locked down (public ssh closed; net + control plane only)"
    echo "  idle ticks: $(cat "$PROFILE_STATE/idle_ticks" 2>/dev/null || echo 0)/$(( REAP_AFTER_IDLE_MIN / 5 )) (reaper checks every 5min)"

    # Age, spend so far, and the hard cap. A cap you cannot see is a cap that
    # ambushes you, so it is always printed — including when it is disabled.
    local age_min
    if age_min=$(box_age_min "$(printf '%s' "$s" | jq -r '.created')"); then
        local spent="?"
        [ -n "${price:-}" ] && [ "$price" != "?" ] && \
            spent=$(awk -v p="$price" -v m="$age_min" 'BEGIN{printf "%.2f", p*m/60}')
        echo "  age: ${age_min}min   spent so far: ~€${spent}"
        if [ "${MAX_LIFETIME_HOURS:-0}" -gt 0 ] 2>/dev/null; then
            local cap_min=$(( MAX_LIFETIME_HOURS * 60 ))
            local left=$(( cap_min - age_min ))
            [ "$left" -lt 0 ] && left=0
            echo "  lifetime cap: ${MAX_LIFETIME_HOURS}h — ${left}min left, then force-reaped even if busy"
        else
            echo "  lifetime cap: DISABLED (MAX_LIFETIME_HOURS=0) — only the idle reaper stops the meter"
        fi
    fi
}

# cmd_status: the whole deployment in one command — every profile's box plus
# the net table ('daybox net' folded in here; the README always promised
# "lists ALL live profiles"). -p scopes to a single profile's block.
cmd_status() {
    if [ -n "$PROFILE_EXPLICIT" ]; then
        need_config
        provider_check_credentials
        status_one
        return 0
    fi
    local p found=
    for p in $(list_profiles); do
        found=1
        # subshell per profile, exactly as cmd_reap: a broken profile config
        # or missing credentials must not hide the other profiles' status
        ( derive_profile "$p"
          provider_has_credentials \
              || { echo "profile '$p': no credentials for provider '$PROVIDER'"; exit 0; }
          status_one ) \
            || log "[$p] status check failed — continuing with other profiles"
    done
    [ -n "$found" ] || echo "no profiles set up yet — run: daybox init"
    echo
    if net_enabled; then
        echo "net members:"
        net_table
    else
        echo "net: DOWN here (headscale/agent missing) — 'daybox up' will refuse"
    fi
}

# ------------------------------------------------------------------ ssh ----
cmd_ssh() { # always over the public ip: the control plane is allowlisted even in strict mode
    need_config
    provider_check_credentials
    local s ip
    s=$(provider_probe "$SERVER_NAME")
    [ "$s" = "null" ] && die "no big box running — summon with: daybox up"
    ip=$(printf '%s' "$s" | jq -r '.ip')
    # no args = a fresh interactive shell; tmux is opt-in via 'daybox attach'
    exec ssh -o UserKnownHostsFile="$KNOWN_HOSTS" \
             -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
             -t "$REMOTE_USER@$ip" "$@"
}

cmd_attach() { # the shared persistent tmux session (survives disconnects)
    cmd_ssh "/home/$REMOTE_USER/.local/bin/devbox-tmux"
}

# ----------------------------------------------------------------- down ----
cmd_down() {
    # Deliberately NO need_config here: teardown is what the reaper calls to
    # stop billing, and it must never be blocked by identity config. A
    # half-edited config.local (GIT_NAME commented out mid-edit) used to make
    # this die -> every reap path (idle, unreachable, lifetime cap) silently
    # defeated while the box billed. Teardown needs only provider credentials
    # and ssh state, both checked below / defaulted.
    provider_check_credentials
    local s id vid
    s=$(provider_probe "$SERVER_NAME")
    if [ "$s" = "null" ]; then log "no big box running"; reset_idle; return 0; fi
    id=$(printf '%s' "$s" | jq -r '.id')
    vid=$(cat "$PROFILE_STATE/volume_id" 2>/dev/null || true)

    if [ -n "$vid" ] && [ "$(provider_volume_attached_to "$vid")" = "$id" ]; then
        log "unmounting /work + detaching volume"
        local ip uerr
        ip=$(printf '%s' "$s" | jq -r '.ip')
        # A plain `umount /work` fails BUSY on any box that did real work —
        # tmux panes keep shells cwd'd under /work/repos, and ~/.claude
        # symlinks into /work/state — so every reap force-detached a volume
        # with a dirty journal (seen 23:01 2026-07-22; the old message blamed
        # "box unreachable", which an instant failure never was). sync FIRST
        # so even a failed unmount detaches with all data flushed, then kill
        # the holders (the box is about to be deleted), then lazy-unmount as
        # the last resort. Keep stderr: busy vs unreachable must be tellable.
        if ! uerr=$(timeout 60 ssh -o UserKnownHostsFile="$KNOWN_HOSTS" -o BatchMode=yes -o ConnectTimeout=5 \
            "$REMOTE_USER@$ip" \
            'sync; sudo umount /work || { sudo fuser -km /work; sleep 1; sudo umount /work; } || { sync; sudo umount -l /work; }' \
            2>&1); then
            log "WARNING: clean unmount failed (${uerr:-no output — box unreachable?}) — detaching anyway; unflushed writes may be lost"
        fi
        provider_volume_detach "$vid"
        # Deleting the server while our detach is still in flight makes
        # Hetzner fire its own auto-detach on top; the two wedge the volume
        # in a locked state that blocks every later summon (seen 2026-07-21:
        # both actions stuck "running", volume pinned to a deleted server).
        # So wait for the detach to actually finish — and if it will not,
        # say so and still delete: billing stops now, the volume unwedges on
        # its own, and the message tells you why the next summon may fail.
        local i detached=
        for i in $(seq 1 60); do
            if [ -z "$(provider_volume_attached_to "$vid")" ]; then
                detached=1; break
            fi
            sleep 2
        done
        [ -n "$detached" ] || log "WARNING: volume still detaching after 120s — deleting the server anyway (billing stops).
  The provider may briefly lock the volume; if the next summon fails with 'volume is locked', wait and re-run."
    fi

    log "deleting server $id (billing stops now)"
    provider_reap "$id"
    reset_idle

    # drop the box's net node immediately — headscale's ephemeral GC would
    # take ~30min, and the net view should never show ghosts
    if net_enabled; then
        local nid
        for nid in $(net_nodes_json | jq -r --arg h "$SERVER_NAME" \
                '.[] | select(.name==$h or .given_name==$h) | .id'); do
            if headscale nodes delete -i "$nid" --force >/dev/null 2>&1; then
                log "net: removed node '$SERVER_NAME' (id $nid)"
            else
                log "net: WARNING: node id $nid was not removed — a stale entry is left on the net"
            fi
        done
    fi
    log "done. workspace persists on volume '$VOLUME_NAME'."
}

# ----------------------------------------------------------------- reap ----
reap_one() { # probe + tick the CURRENT profile's box; reap it when idle/unreachable
    local s ip
    s=$(provider_probe "$SERVER_NAME")
    if [ "$s" = "null" ]; then reset_idle; return 0; fi
    ip=$(printf '%s' "$s" | jq -r '.ip')

    # ---- hard lifetime cap (runaway backstop) ----
    # Checked BEFORE the busy probe and independently of every busy signal, on
    # purpose: a box that always looks busy is exactly the case the idle reaper
    # cannot stop. The workspace volume survives the reap, so what is lost is
    # the root disk and running processes — not your repos or state.
    if [ "${MAX_LIFETIME_HOURS:-0}" -gt 0 ] 2>/dev/null; then
        local age_min cap_min left
        cap_min=$(( MAX_LIFETIME_HOURS * 60 ))
        if age_min=$(box_age_min "$(printf '%s' "$s" | jq -r '.created')"); then
            if [ "$age_min" -ge "$cap_min" ]; then
                log "[$PROFILE] LIFETIME CAP: box is ${age_min}min old (cap ${MAX_LIFETIME_HOURS}h) — force reaping regardless of activity"
                cmd_down
                return 0
            fi
            left=$(( cap_min - age_min ))
            if [ "$left" -le 30 ]; then
                log "[$PROFILE] WARNING: lifetime cap in ${left}min — this box will be reaped even if busy. 'daybox down && daybox up' starts a fresh one."
            fi
        else
            log "[$PROFILE] WARNING: could not parse box creation time — lifetime cap NOT enforced this tick"
        fi
    fi

    local probe conns load working
    # three busy signals: ssh sessions, load, and RECENT CLAUDE TRANSCRIPT
    # WRITES — a detached claude working on an API-bound task shows load
    # ~0.2 and zero connections, and the reaper once killed one mid-task
    # (2026-07-15, one minute before its last transcript write). Each profile
    # has its own volume, so /work/state/claude here is this profile's.
    # `timeout` bounds the WHOLE probe, not just the connect: a box whose
    # sshd accepts the TCP connection and then wedges (OOM, fork bomb) would
    # otherwise hang this run forever — Type=oneshot never times out on its
    # own and the timer never refires while the unit is active, so reaping
    # would stop for every profile while the boxes bill.
    if probe=$(timeout 30 ssh -o UserKnownHostsFile="$KNOWN_HOSTS" -o BatchMode=yes -o ConnectTimeout=5 \
            "$REMOTE_USER@$ip" \
            "ss -Htn state established '( sport = :22 )' | grep -vc '$LITTLEBOX_IP' ; cut -d' ' -f1 /proc/loadavg ; find /work/state/claude/projects -type f -newermt '-10 minutes' 2>/dev/null | head -1" \
            2>/dev/null); then
        conns=$(printf '%s\n' "$probe" | sed -n 1p)
        load=$(printf '%s\n' "$probe" | sed -n 2p)
        working=$(printf '%s\n' "$probe" | sed -n 3p)
        echo 0 > "$PROFILE_STATE/unreachable_ticks"
        # Misconfigured knobs must degrade toward KEEPING the box, never
        # toward a surprise reap: a non-numeric LOAD_BUSY would compare as 0
        # (everything reads busy — box never reaped, meter runs) and an
        # IDLE_MIN under one tick would reap on the first quiet probe.
        [[ "$LOAD_BUSY" =~ ^[0-9]+([.][0-9]+)?$ ]] \
            || { log "[$PROFILE] invalid LOAD_BUSY '$LOAD_BUSY' — using 0.40"; LOAD_BUSY=0.40; }
        local need=$(( REAP_AFTER_IDLE_MIN / 5 )); [ "$need" -ge 1 ] || need=1
        if [ "${conns:-1}" -gt 0 ] || [ -n "$working" ] || \
           [ "$(awk -v l="${load:-99}" -v t="$LOAD_BUSY" 'BEGIN{print (l>=t)?1:0}')" = "1" ]; then
            echo 0 > "$PROFILE_STATE/idle_ticks"
            return 0
        fi
        local ticks
        ticks=$(( $(cat "$PROFILE_STATE/idle_ticks" 2>/dev/null || echo 0) + 1 ))
        echo "$ticks" > "$PROFILE_STATE/idle_ticks"
        log "[$PROFILE] idle tick $ticks/$need (conns=$conns load=$load)"
        if [ "$ticks" -ge "$need" ]; then
            log "[$PROFILE] idle for ${REAP_AFTER_IDLE_MIN}min — reaping"
            cmd_down
        fi
    else
        local u
        u=$(( $(cat "$PROFILE_STATE/unreachable_ticks" 2>/dev/null || echo 0) + 1 ))
        echo "$u" > "$PROFILE_STATE/unreachable_ticks"
        log "[$PROFILE] big box unreachable (tick $u/12)"
        # an hour of unreachable = zombie that still bills; cut our losses
        if [ "$u" -ge 12 ]; then
            log "[$PROFILE] unreachable for 1h — force reaping"
            cmd_down
        fi
    fi
    # Must end 0. This file runs under `set -e`, and cmd_reap calls reap_one
    # bare in a loop over profiles: a non-zero return here aborts the whole
    # run, so one unreachable box would stop every OTHER profile's box from
    # being reaped — and they would keep billing. (Was exactly that: the
    # trailing `[ "$u" -ge 12 ] && {...}` above returned 1 on every ordinary
    # unreachable tick.)
    return 0
}

cmd_reap() {
    # Quiet no-op ONLY before 'daybox init' has run at all. The gate was
    # previously missing_config, which also fires on a half-edited
    # config.local (GIT_NAME gone) — silently disabling the reaper while a
    # box bills. Reaping needs LITTLEBOX_IP (probe self-exclusion) and
    # provider credentials; it never uses the git identity.
    [ -n "${LITTLEBOX_IP:-}" ] || exit 0
    # every profile is its own box with its own counters and idle timeout —
    # reap them independently (README: Profiles). No profiles set up yet = noop.
    local p
    for p in $(list_profiles); do
        # Each profile runs in a SUBSHELL, for two load-bearing reasons:
        #  1. die calls `exit`, which `reap_one || log` cannot contain — a
        #     profile with a broken config (derive_profile dies) or a failed
        #     teardown (api dies inside cmd_down) would kill this whole run,
        #     and every LATER profile's box would keep billing, every tick.
        #  2. belt and braces on top of derive_profile's knob reset: nothing
        #     one profile's config does can leak into the next.
        # Credentials are checked PER PROFILE, after derive_profile has
        # loaded that profile's provider — a global check reads whichever
        # provider the CLI-selected profile uses, and a missing default-
        # profile token would silently stop reaping every OTHER provider's
        # boxes while they bill.
        ( derive_profile "$p"
          provider_has_credentials \
              || { log "[$p] no credentials for provider '$PROVIDER' — cannot reap-check"; exit 0; }
          reap_one ) \
            || log "[$p] reap check failed — continuing with other profiles"
    done
    return 0
}

# ------------------------------------------------------------------ net ----
net_table() {
    net_nodes_json | jq -r '
        (["ID","NAME","ADDRESS","USER","STATE","KIND","LASTSEEN"] | @tsv),
        (.[] | [ (.id|tostring),
                 .given_name,
                 (.ip_addresses[0] // "-"),
                 (.user.name // "-"),
                 (if (.online // .connected // false) then "online" else "offline" end),
                 (if ((.pre_auth_key.ephemeral? // .ephemeral // false)) then "ephemeral" else "device" end),
                 ((.last_seen.seconds? | values | todate) // "-") ] | @tsv)' \
      | column -t -s "$(printf '\t')"
}

cmd_net() { # deprecated spelling — the table is part of 'daybox status' now
    net_enabled || die "net not set up here (the README): needs headscale + agent at $NET_AGENT_BIN"
    log "'daybox net' is folded into 'daybox status' — this alias still prints the table"
    net_table
}

# --------------------------------------------------------------- render ----
cmd_render() {
    need_config
    need_seed
    local vid
    vid=$(cat "$PROFILE_STATE/volume_id" 2>/dev/null || echo 0000000)
    render_user_data "$vid"
}

# ------------------------------------------------------------- dispatch ----
# Sourcing this file with DAYBOX_SOURCE_ONLY=1 defines everything and stops
# short of dispatch, so the reap/cap decisions can be exercised with stubs.
# The reaper deletes running machines; that logic deserves a test.
[ -n "${DAYBOX_SOURCE_ONLY:-}" ] && return 0

usage() {
    sed -n '/^# Usage:/,/^#$/p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 2
}

case "${1:-}" in
    setup)   cmd_setup ;;
    up)      shift; cmd_up "$@" ;;
    status)  cmd_status ;;
    ssh)     shift; cmd_ssh "$@" ;;
    attach)  cmd_attach ;;
    down)    cmd_down ;;
    reap)    cmd_reap ;;
    net)     cmd_net ;;
    profile) shift; cmd_profile "$@" ;;
    render)  cmd_render ;;
    *)       usage ;;
esac
